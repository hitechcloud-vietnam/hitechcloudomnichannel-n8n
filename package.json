{
    "name": "n8n-nodes-hitechcloudomnichannel",
    "version": "0.1.4",
    "description": "n8n community nodes for the HiTechCloudOmnichannel Public API and webhooks",
    "license": "MIT",
    "homepage": "https://hitechcloud.vn",
    "keywords": [
        "n8n-community-node-package",
        "hitechcloudomnichannel",
        "chatbot",
        "automation",
        "omnichannel"
    ],
    "author": {
        "name": "ChatbotXIO",
        "email": "support@hitechcloud.vn"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/hitechcloud-vietnam/hitechcloudomnichannel-n8n.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "dotenv -e .env -- n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "check-types": "tsc --noEmit",
        "test": "npm run build && node --test tests/*.test.cjs",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/ChatbotXApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/HiTechCloudOmnichannel/HiTechCloudOmnichannel.node.js",
            "dist/nodes/HiTechCloudOmnichannel/ChatbotXTriggerEvents.node.js",
            "dist/nodes/HiTechCloudOmnichannel/ChatbotXTriggerFlowData.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "^0.43.4",
        "dotenv-cli": "^11.0.0",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
